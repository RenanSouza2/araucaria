+
+constexpr uint64_t probe_text_max = 16384;
+
+// whole file into buf, NUL terminated; empty when it cannot be read
+[[maybe_unused]]
+static void probe_slurp(const char * path, char * buf, uint64_t cap)
+{
+    buf[0] = '\0';
+    FILE * fp = fopen(path, "r");
+    if(!fp)
+    {
+        return;
+    }
+
+    size_t got = fread(buf, 1, cap - 1, fp);
+    buf[got] = '\0';
+    fclose(fp);
+}
+
+// number after KEY where KEY starts a line, 0 when absent
+[[maybe_unused]]
+static uint64_t probe_field(const char * text, const char * key)
+{
+    size_t len = strlen(key);
+    const char * line = text;
+    while(line && *line)
+    {
+        if(strncmp(line, key, len) == 0)
+        {
+            return strtoull(line + len, nullptr, 10);
+        }
+
+        line = strchr(line, '\n');
+        if(line)
+        {
+            line++;
+        }
+    }
+    return 0;
+}
+
+// total= of the KIND line ("some" or "full") of a /proc/pressure file, in usec
+[[maybe_unused]]
+static uint64_t probe_pressure(const char * text, const char * kind)
+{
+    size_t len = strlen(kind);
+    const char * line = text;
+    while(line && *line)
+    {
+        if(strncmp(line, kind, len) == 0)
+        {
+            const char * total = strstr(line, "total=");
+            return total ? strtoull(total + 6, nullptr, 10) : 0;
+        }
+
+        line = strchr(line, '\n');
+        if(line)
+        {
+            line++;
+        }
+    }
+    return 0;
+}
+
+typedef struct
+{
+    uint64_t user_ns;
+    uint64_t sys_ns;
+    uint64_t majflt;
+    uint64_t minflt;
+    uint64_t disk_rd;
+    uint64_t disk_wr;
+    uint64_t pageins;
+    uint64_t footprint;
+} probe_proc_t;
+
+// compiled on every platform so the Linux reader is at least type checked here
+[[maybe_unused]]
+static void probe_proc_read_linux(probe_proc_t * out)
+{
+    char text[probe_text_max];
+    probe_slurp("/proc/self/io", text, sizeof(text));
+    out->disk_rd = probe_field(text, "read_bytes:");
+    out->disk_wr = probe_field(text, "write_bytes:");
+    out->pageins = out->majflt;
+
+    probe_slurp("/proc/self/status", text, sizeof(text));
+    out->footprint = probe_field(text, "VmRSS:") * 1024;
+}
+
+static uint64_t probe_tv_ns(struct timeval tv)
+{
+    return ((uint64_t)tv.tv_sec * nanosecs_in_sec) + ((uint64_t)tv.tv_usec * 1000);
+}
+
+static probe_proc_t probe_proc_read()
+{
+    struct rusage ru;
+    int res = getrusage(RUSAGE_SELF, &ru);
+    assert(res == 0);
+
+    probe_proc_t out =
+    {
+        .user_ns = probe_tv_ns(ru.ru_utime),
+        .sys_ns = probe_tv_ns(ru.ru_stime),
+        .majflt = (uint64_t)ru.ru_majflt,
+        .minflt = (uint64_t)ru.ru_minflt,
+    };
+
+#ifdef __APPLE__
+    struct rusage_info_v4 ri;
+    if(proc_pid_rusage(getpid(), RUSAGE_INFO_V4, (rusage_info_t *)&ri) == 0)
+    {
+        out.disk_rd = ri.ri_diskio_bytesread;
+        out.disk_wr = ri.ri_diskio_byteswritten;
+        out.pageins = ri.ri_pageins;
+        out.footprint = ri.ri_phys_footprint;
+    }
+#else
+    probe_proc_read_linux(&out);
+#endif
+
+    return out;
+}
+
+constexpr uint64_t probe_cpu_max = 64;
+
+[[maybe_unused]]
+static uint64_t probe_page_bytes;
+
+constexpr uint64_t probe_dev_max = 32;
+
+// cpu times in 10 ms ticks; a field the platform cannot report stays 0
+typedef struct
+{
+    uint64_t cpus;
+    uint64_t busy[probe_cpu_max];
+    uint64_t kern_ticks;
+    uint64_t busy_ticks;
+    uint64_t iowait_ticks;
+    uint64_t free_bytes;
+    uint64_t file_bytes;
+    uint64_t anon_bytes;
+    uint64_t comp_bytes;
+    uint64_t dirty_bytes;
+    uint64_t writeback_bytes;
+    uint64_t swap_used;
+    uint64_t pagein_bytes;
+    uint64_t pageout_bytes;
+    uint64_t compressions;
+    uint64_t decompressions;
+    uint64_t swapins;
+    uint64_t swapouts;
+    uint64_t scan_direct;
+    uint64_t allocstall;
+    uint64_t psi_io_some;
+    uint64_t psi_io_full;
+    uint64_t psi_mem_some;
+    uint64_t psi_mem_full;
+    uint64_t dev_rd_bytes;
+    uint64_t dev_wr_bytes;
+    uint64_t dev_queue_ms;
+    uint64_t devs;
+    uint64_t dev_busy_ms[probe_dev_max];
+    uint64_t mem_level;
+    uint64_t thermal;
+    uint64_t lpm;
+} probe_sys_t;
+
+#ifdef __APPLE__
+
+static uint64_t probe_notify_state(const char * key, int * token)
+{
+    if(*token < 0 && notify_register_check(key, token) != NOTIFY_STATUS_OK)
+    {
+        *token = -1;
+        return UINT64_MAX;
+    }
+
+    uint64_t state = 0;
+    if(notify_get_state(*token, &state) != NOTIFY_STATUS_OK)
+    {
+        return UINT64_MAX;
+    }
+    return state;
+}
+
+#endif
+
+static bool probe_is_digit(char c)
+{
+    return (bool)(c >= '0' && c <= '9');
+}
+
+// whole disks only: partitions and stacked devices would count the same I/O twice
+[[maybe_unused]]
+static bool probe_dev_is_disk(const char * name)
+{
+    const char * skip[] = { "loop", "ram", "zram", "dm-", "md", "sr", "fd" };
+    for(uint64_t i=0; i<sizeof(skip)/sizeof(skip[0]); i++)
+    {
+        if(strncmp(name, skip[i], strlen(skip[i])) == 0)
+        {
+            return false;
+        }
+    }
+
+    size_t len = strlen(name);
+    if(len == 0)
+    {
+        return false;
+    }
+    if(!probe_is_digit(name[len - 1]))
+    {
+        return true;
+    }
+
+    // nvme0n1 and mmcblk0 end in a digit themselves; their partitions add pN
+    if(strncmp(name, "nvme", 4) != 0 && strncmp(name, "mmcblk", 6) != 0)
+    {
+        return false;
+    }
+    const char * part = strrchr(name, 'p');
+    if(!part || part == name || !probe_is_digit(part[-1]) || part[1] == '\0')
+    {
+        return true;
+    }
+    return (bool)(strspn(part + 1, "0123456789") != strlen(part + 1));
+}
+
+static const char * probe_next_line(const char * line)
+{
+    const char * next = strchr(line, '\n');
+    return next ? next + 1 : nullptr;
+}
+
+// compiled on every platform so the Linux reader is at least type checked here
+[[maybe_unused]]
+static void probe_sys_read_linux(probe_sys_t * out)
+{
+    constexpr uint64_t kb = 1024;
+    constexpr uint64_t sector = 512;
+    char text[probe_text_max];
+
+    // cpu[N] user nice system idle iowait irq softirq steal
+    probe_slurp("/proc/stat", text, sizeof(text));
+    const char * line = text;
+    while(line && strncmp(line, "cpu", 3) == 0)
+    {
+        const char * cursor = line + 3;
+        char * end = nullptr;
+        bool total = (bool)(*cursor == ' ');
+        if(!total)
+        {
+            (void)strtoull(cursor, &end, 10);
+            cursor = end;
+        }
+
+        uint64_t v[8] = {0};
+        for(uint64_t i=0; i<8; i++)
+        {
+            v[i] = strtoull(cursor, &end, 10);
+            cursor = end;
+        }
+
+        uint64_t kern = v[2] + v[5] + v[6];
+        uint64_t busy = kern + v[0] + v[1] + v[7];
+        if(total)
+        {
+            out->kern_ticks = kern;
+            out->busy_ticks = busy;
+            out->iowait_ticks = v[4];
+        }
+        else if(out->cpus < probe_cpu_max)
+        {
+            out->busy[out->cpus] = busy;
+            out->cpus++;
+        }
+        line = probe_next_line(line);
+    }
+
+    probe_slurp("/proc/meminfo", text, sizeof(text));
+    out->free_bytes = probe_field(text, "MemFree:") * kb;
+    out->file_bytes = probe_field(text, "Cached:") * kb;
+    out->anon_bytes = probe_field(text, "AnonPages:") * kb;
+    out->dirty_bytes = probe_field(text, "Dirty:") * kb;
+    out->writeback_bytes = probe_field(text, "Writeback:") * kb;
+    out->swap_used = (probe_field(text, "SwapTotal:") - probe_field(text, "SwapFree:")) * kb;
+
+    probe_slurp("/proc/vmstat", text, sizeof(text));
+    out->pagein_bytes = probe_field(text, "pgpgin ") * kb;
+    out->pageout_bytes = probe_field(text, "pgpgout ") * kb;
+    out->swapins = probe_field(text, "pswpin ");
+    out->swapouts = probe_field(text, "pswpout ");
+    out->scan_direct = probe_field(text, "pgscan_direct ");
+    out->allocstall = probe_field(text, "allocstall_normal ")
+        + probe_field(text, "allocstall_movable ")
+        + probe_field(text, "allocstall_dma32 ");
+
+    probe_slurp("/proc/pressure/io", text, sizeof(text));
+    out->psi_io_some = probe_pressure(text, "some");
+    out->psi_io_full = probe_pressure(text, "full");
+
+    probe_slurp("/proc/pressure/memory", text, sizeof(text));
+    out->psi_mem_some = probe_pressure(text, "some");
+    out->psi_mem_full = probe_pressure(text, "full");
+
+    // major minor name, then 11 counters: sectors read is the 3rd, sectors written
+    // the 7th, ms busy the 10th, weighted ms queued the 11th
+    probe_slurp("/proc/diskstats", text, sizeof(text));
+    line = text;
+    while(line && *line)
+    {
+        unsigned int dev_major, dev_minor;
+        char name[64];
+        uint64_t f[11] = {0};
+        int got = sscanf(
+            line,
+            " %u %u %63s %" SCNu64 " %" SCNu64 " %" SCNu64 " %" SCNu64 " %" SCNu64 " %" SCNu64
+            " %" SCNu64 " %" SCNu64 " %" SCNu64 " %" SCNu64 " %" SCNu64,
+            &dev_major, &dev_minor, name,
+            &f[0], &f[1], &f[2], &f[3], &f[4], &f[5], &f[6], &f[7], &f[8], &f[9], &f[10]
+        );
+        if(got == 14 && probe_dev_is_disk(name) && out->devs < probe_dev_max)
+        {
+            out->dev_rd_bytes += f[2] * sector;
+            out->dev_wr_bytes += f[6] * sector;
+            out->dev_queue_ms += f[10];
+            out->dev_busy_ms[out->devs] = f[9];
+            out->devs++;
+        }
+        line = probe_next_line(line);
+    }
+}
+
+static probe_sys_t probe_sys_read()
+{
+    probe_sys_t out = {0};
+
+#ifdef __APPLE__
+    static host_t host = MACH_PORT_NULL;
+    static int token_lpm = -1;
+    static int token_thermal = -1;
+    if(host == MACH_PORT_NULL)
+    {
+        host = mach_host_self();
+    }
+
+    natural_t cpus = 0;
+    processor_info_array_t info = nullptr;
+    mach_msg_type_number_t info_count = 0;
+    kern_return_t kr = host_processor_info(host, PROCESSOR_CPU_LOAD_INFO, &cpus, &info, &info_count);
+    if(kr == KERN_SUCCESS)
+    {
+        out.cpus = cpus < probe_cpu_max ? cpus : probe_cpu_max;
+        for(uint64_t i=0; i<out.cpus; i++)
+        {
+            const integer_t * ticks = &info[i * CPU_STATE_MAX];
+            uint64_t kern = (uint64_t)(uint32_t)ticks[CPU_STATE_SYSTEM];
+            uint64_t user = (uint64_t)(uint32_t)ticks[CPU_STATE_USER]
+                + (uint64_t)(uint32_t)ticks[CPU_STATE_NICE];
+            out.busy[i] = kern + user;
+            out.kern_ticks += kern;
+            out.busy_ticks += kern + user;
+        }
+        vm_deallocate(mach_task_self(), (vm_address_t)info, info_count * sizeof(integer_t));
+    }
+
+    vm_statistics64_data_t vm;
+    mach_msg_type_number_t vm_count = HOST_VM_INFO64_COUNT;
+    kr = host_statistics64(host, HOST_VM_INFO64, (host_info64_t)&vm, &vm_count);
+    if(kr == KERN_SUCCESS)
+    {
+        out.free_bytes = vm.free_count * probe_page_bytes;
+        out.file_bytes = vm.external_page_count * probe_page_bytes;
+        out.anon_bytes = vm.internal_page_count * probe_page_bytes;
+        out.comp_bytes = vm.compressor_page_count * probe_page_bytes;
+        out.pagein_bytes = vm.pageins * probe_page_bytes;
+        out.pageout_bytes = vm.pageouts * probe_page_bytes;
+        out.compressions = vm.compressions;
+        out.decompressions = vm.decompressions;
+        out.swapins = vm.swapins;
+        out.swapouts = vm.swapouts;
+    }
+
+    struct xsw_usage swap;
+    size_t len = sizeof(swap);
+    if(sysctlbyname("vm.swapusage", &swap, &len, nullptr, 0) == 0)
+    {
+        out.swap_used = swap.xsu_used;
+    }
+
+    int level = 0;
+    len = sizeof(level);
+    if(sysctlbyname("kern.memorystatus_vm_pressure_level", &level, &len, nullptr, 0) == 0)
+    {
+        out.mem_level = (uint64_t)level;
+    }
+
+    out.lpm = probe_notify_state("com.apple.system.lowpowermode", &token_lpm);
+    out.thermal = probe_notify_state("com.apple.system.thermalpressurelevel", &token_thermal);
+#else
+    probe_sys_read_linux(&out);
+#endif
+
+    return out;
+}
+
+typedef struct
+{
+    const char * stage;
+    const char * phase;
+    uint64_t units;
+    uint64_t active;
+    uint64_t in_rd;
+    uint64_t in_wr;
+    uint64_t rd_bytes;
+    uint64_t rd_ns;
+    uint64_t wr_bytes;
+    uint64_t wr_ns;
+} probe_prof_t;
+
+static probe_prof_t probe_prof_read()
+{
+    probe_prof_t out = { .stage = "-", .phase = "-" };
+
+#ifdef ARAUCARIA_PROF
+    const char * stage = atomic_load(&g_num_prof.stage);
+    const char * phase = atomic_load(&g_num_prof.phase);
+    out.stage = stage ? stage : "-";
+    out.phase = phase ? phase : "-";
+    out.units = atomic_load(&g_num_prof.units_done);
+    out.active = atomic_load(&g_num_prof.active_workers);
+    out.in_rd = atomic_load(&g_num_prof.in_rd);
+    out.in_wr = atomic_load(&g_num_prof.in_wr);
+    out.rd_bytes = atomic_load(&g_num_prof.rd_bytes);
+    out.rd_ns = atomic_load(&g_num_prof.rd_ns);
+    out.wr_bytes = atomic_load(&g_num_prof.wr_bytes);
+    out.wr_ns = atomic_load(&g_num_prof.wr_ns);
+#endif
+
+    return out;
+}
