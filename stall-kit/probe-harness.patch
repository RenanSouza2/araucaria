+#ifndef NUM_PROF_H
+#define NUM_PROF_H
+
+// TEMPORARY: stall investigation hooks. Not to be committed; every use in
+// code.c carries PROF_ so it can be stripped with a grep.
+
+#ifdef ARAUCARIA_PROF
+
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+typedef struct
+{
+    uint64_t wall_ns;
+    uint64_t cpu_ns;
+    uint64_t rd_ns;
+    uint64_t wr_ns;
+    uint64_t rd_bytes;
+    uint64_t wr_bytes;
+    uint64_t pad_ns;
+    uint64_t pw_ns;
+} num_prof_round_t;
+
+typedef struct
+{
+    _Atomic(const char *) stage;
+    _Atomic(const char *) phase;
+    _Atomic uint64_t units_done;
+    _Atomic uint64_t active_workers;
+    _Atomic uint64_t in_rd;
+    _Atomic uint64_t in_wr;
+    _Atomic uint64_t rd_bytes;
+    _Atomic uint64_t rd_ns;
+    _Atomic uint64_t rd_calls;
+    _Atomic uint64_t wr_bytes;
+    _Atomic uint64_t wr_ns;
+    _Atomic uint64_t wr_calls;
+    // experiment: the first worker to enter each pass sleeps this long per block
+    _Atomic uint64_t slow_ns;
+    _Atomic uint64_t slow_claim;
+    // experiment: nonzero gives staged pass workers fixed ranges again
+    _Atomic uint64_t static_ranges;
+    void (*on_mark)(const char * label);
+    void (*on_round)(
+        const char * kind,
+        uint64_t worker,
+        uint64_t round,
+        uint64_t r,
+        uint64_t gl,
+        const num_prof_round_t * stat
+    );
+} num_prof_t;
+
+extern num_prof_t g_num_prof;
+extern thread_local num_prof_round_t t_num_prof;
+
+// Optional check that a staged element reads back as it was last written: one
+// hash per element of each transform array, kept in RAM. Valid only while every
+// write of the array goes through the staged transfers.
+constexpr uint64_t num_prof_verify_max = 4;
+
+typedef struct
+{
+    const void * key;
+    uint64_t count;
+    uint64_t * sums;
+} num_prof_verify_t;
+
+extern atomic_bool g_num_prof_verify_on;
+extern num_prof_verify_t g_num_prof_verify[num_prof_verify_max];
+extern _Atomic uint64_t g_num_prof_verify_checked;
+
+[[maybe_unused]]
+static inline uint64_t num_prof_hash(const uint64_t * limbs, uint64_t n)
+{
+    uint64_t h = UINT64_C(0x9e3779b97f4a7c15);
+    for(uint64_t i = 0; i < n; i++)
+    {
+        h = (h ^ limbs[i]) * UINT64_C(0xff51afd7ed558ccd);
+        h ^= h >> 29;
+    }
+    return h | 1;
+}
+
+// tables are created by the thread that starts the multiply, before any worker
+[[maybe_unused]]
+static inline void num_prof_verify_begin(const void * key, uint64_t count)
+{
+    if(!atomic_load(&g_num_prof_verify_on))
+    {
+        return;
+    }
+
+    uint64_t slot = num_prof_verify_max;
+    for(uint64_t i = 0; i < num_prof_verify_max; i++)
+    {
+        if(g_num_prof_verify[i].key == key || (slot == num_prof_verify_max && !g_num_prof_verify[i].key))
+        {
+            slot = i;
+        }
+        if(g_num_prof_verify[i].key == key)
+        {
+            break;
+        }
+    }
+    if(slot == num_prof_verify_max)
+    {
+        return;
+    }
+
+    free(g_num_prof_verify[slot].sums);
+    g_num_prof_verify[slot] = (num_prof_verify_t)
+    {
+        .key = key,
+        .count = count,
+        .sums = calloc(count, sizeof(uint64_t)),
+    };
+}
+
+[[maybe_unused]]
+static inline void num_prof_verify_end(const void * key)
+{
+    for(uint64_t i = 0; i < num_prof_verify_max; i++)
+    {
+        if(g_num_prof_verify[i].key == key)
+        {
+            free(g_num_prof_verify[i].sums);
+            g_num_prof_verify[i] = (num_prof_verify_t){0};
+        }
+    }
+}
+
+[[maybe_unused]]
+static inline uint64_t * num_prof_verify_slot(const void * key, uint64_t elem)
+{
+    for(uint64_t i = 0; i < num_prof_verify_max; i++)
+    {
+        if(g_num_prof_verify[i].key == key && g_num_prof_verify[i].sums && elem < g_num_prof_verify[i].count)
+        {
+            return &g_num_prof_verify[i].sums[elem];
+        }
+    }
+    return nullptr;
+}
+
+[[maybe_unused]]
+static inline void num_prof_verify_wrote(const void * key, uint64_t elem, const uint64_t * limbs, uint64_t n)
+{
+    uint64_t * sum = num_prof_verify_slot(key, elem);
+    if(sum)
+    {
+        *sum = num_prof_hash(limbs, n);
+    }
+}
+
+[[maybe_unused]]
+static inline void num_prof_verify_read(const void * key, uint64_t elem, const uint64_t * limbs, uint64_t n)
+{
+    uint64_t * sum = num_prof_verify_slot(key, elem);
+    if(!sum || !*sum)
+    {
+        return;
+    }
+
+    atomic_fetch_add_explicit(&g_num_prof_verify_checked, 1, memory_order_relaxed);
+    uint64_t got = num_prof_hash(limbs, n);
+    if(got != *sum)
+    {
+        const char * stage = atomic_load(&g_num_prof.stage);
+        const char * phase = atomic_load(&g_num_prof.phase);
+        uint64_t zeros = 0;
+        for(uint64_t i = 0; i < n; i++)
+        {
+            zeros += limbs[i] == 0;
+        }
+        fprintf(
+            stderr,
+            "\n\n*** IOVERIFY: element %llu of array %llx read back differently from what was written"
+            " (stage %s, phase %s, %llu limbs of which %llu are zero, hash %016llx, expected %016llx) ***\n\n",
+            (unsigned long long)elem, (unsigned long long)(uintptr_t)key,
+            stage ? stage : "-", phase ? phase : "-",
+            (unsigned long long)n, (unsigned long long)zeros,
+            (unsigned long long)got, (unsigned long long)*sum
+        );
+        exit(99);
+    }
+}
+
+[[maybe_unused]]
+static inline uint64_t num_prof_clock(clockid_t id)
+{
+    struct timespec ts;
+    clock_gettime(id, &ts);
+    return ((uint64_t)ts.tv_sec * UINT64_C(1000000000)) + (uint64_t)ts.tv_nsec;
+}
+
+[[maybe_unused]]
+static inline num_prof_round_t num_prof_round_now(void)
+{
+    num_prof_round_t now = t_num_prof;
+    now.wall_ns = num_prof_clock(CLOCK_MONOTONIC);
+    now.cpu_ns = num_prof_clock(CLOCK_THREAD_CPUTIME_ID);
+    return now;
+}
+
+[[maybe_unused]]
+static inline void num_prof_round_end(
+    const char * kind,
+    uint64_t worker,
+    uint64_t round,
+    uint64_t r,
+    uint64_t gl,
+    const num_prof_round_t * begin
+)
+{
+    if(!g_num_prof.on_round)
+    {
+        return;
+    }
+
+    num_prof_round_t now = num_prof_round_now();
+    num_prof_round_t d =
+    {
+        .wall_ns = now.wall_ns - begin->wall_ns,
+        .cpu_ns = now.cpu_ns - begin->cpu_ns,
+        .rd_ns = now.rd_ns - begin->rd_ns,
+        .wr_ns = now.wr_ns - begin->wr_ns,
+        .rd_bytes = now.rd_bytes - begin->rd_bytes,
+        .wr_bytes = now.wr_bytes - begin->wr_bytes,
+        .pad_ns = now.pad_ns - begin->pad_ns,
+        .pw_ns = now.pw_ns - begin->pw_ns,
+    };
+    g_num_prof.on_round(kind, worker, round, r, gl, &d);
+}
+
+#define PROF_DEFINE                                                 \
+    num_prof_t g_num_prof;                                          \
+    thread_local num_prof_round_t t_num_prof;                       \
+    atomic_bool g_num_prof_verify_on;                               \
+    num_prof_verify_t g_num_prof_verify[num_prof_verify_max];       \
+    _Atomic uint64_t g_num_prof_verify_checked;
+
+#define PROF_VERIFY_BEGIN(KEY, COUNT) num_prof_verify_begin(KEY, COUNT);
+#define PROF_VERIFY_END(KEY) num_prof_verify_end(KEY);
+#define PROF_VERIFY_WROTE(KEY, ELEM, LIMBS, N, WIDTH)                                   \
+    for(uint64_t _prof_e = 0; _prof_e < (WIDTH); _prof_e++)                             \
+    {                                                                                   \
+        num_prof_verify_wrote(KEY, (ELEM) + _prof_e, &(LIMBS)[_prof_e * (N)], N);       \
+    }
+
+#define PROF_VERIFY_READ(KEY, ELEM, LIMBS, N, WIDTH)                                    \
+    for(uint64_t _prof_e = 0; _prof_e < (WIDTH); _prof_e++)                             \
+    {                                                                                   \
+        num_prof_verify_read(KEY, (ELEM) + _prof_e, &(LIMBS)[_prof_e * (N)], N);        \
+    }
+
+[[maybe_unused]]
+static const char * const num_prof_fwd_names[] =
+{
+    "fwd-p0", "fwd-p1", "fwd-p2", "fwd-p3", "fwd-p4", "fwd-p5", "fwd-p6", "fwd-p7",
+};
+
+[[maybe_unused]]
+static const char * const num_prof_inv_names[] =
+{
+    "inv-p0", "inv-p1", "inv-p2", "inv-p3", "inv-p4", "inv-p5", "inv-p6", "inv-p7",
+};
+
+#define PROF_COUNTER(NAME) uint64_t NAME = 0;
+#define PROF_COUNT(NAME) NAME++;
+#define PROF_PASS_NAME(DIR, IDX) num_prof_##DIR##_names[(IDX) < 8 ? (IDX) : 7]
+
+#define PROF_STAGE(NAME) atomic_store(&g_num_prof.stage, NAME);
+#define PROF_PHASE(NAME)                                \
+    atomic_store(&g_num_prof.phase, NAME);              \
+    atomic_store(&g_num_prof.slow_claim, 0);
+
+#define PROF_DYNAMIC(COND) ((COND) && !atomic_load(&g_num_prof.static_ranges))
+
+#define PROF_SLOW_ENTER \
+    bool _prof_slow = (bool)(atomic_exchange(&g_num_prof.slow_claim, 1) == 0);
+
+#define PROF_SLOW_BLOCK                                                         \
+    if(_prof_slow && atomic_load(&g_num_prof.slow_ns))                          \
+    {                                                                           \
+        uint64_t _prof_ns = atomic_load(&g_num_prof.slow_ns);                   \
+        struct timespec _prof_ts =                                              \
+        {                                                                       \
+            .tv_sec = (time_t)(_prof_ns / UINT64_C(1000000000)),                \
+            .tv_nsec = (long)(_prof_ns % UINT64_C(1000000000)),                 \
+        };                                                                      \
+        nanosleep(&_prof_ts, nullptr);                                          \
+    }
+#define PROF_MARK(LABEL) { if(g_num_prof.on_mark) { g_num_prof.on_mark(LABEL); } }
+#define PROF_UNITS(ON, COUNT)                                                           \
+    if(ON)                                                                              \
+    {                                                                                   \
+        atomic_fetch_add_explicit(&g_num_prof.units_done, COUNT, memory_order_relaxed); \
+    }
+
+#define PROF_WORKER_ENTER(ON) if(ON) { atomic_fetch_add(&g_num_prof.active_workers, 1); }
+#define PROF_WORKER_LEAVE(ON) if(ON) { atomic_fetch_sub(&g_num_prof.active_workers, 1); }
+
+#define PROF_ROUND_BEGIN(ON)                        \
+    bool _prof_on = (bool)(ON);                     \
+    num_prof_round_t _prof_begin = {0};             \
+    if(_prof_on)                                    \
+    {                                               \
+        _prof_begin = num_prof_round_now();         \
+    }
+
+#define PROF_ROUND_END(KIND, WORKER, ROUND, R, GL)                          \
+    if(_prof_on)                                                            \
+    {                                                                       \
+        num_prof_round_end(KIND, WORKER, ROUND, R, GL, &_prof_begin);       \
+    }
+
+// time inside the span, less what its own block reads took
+#define PROF_TIMED_BEGIN                                        \
+    uint64_t _prof_timed = num_prof_clock(CLOCK_MONOTONIC);     \
+    uint64_t _prof_timed_rd = t_num_prof.rd_ns;
+
+#define PROF_TIMED_END(FIELD)                                           \
+    t_num_prof.FIELD += (num_prof_clock(CLOCK_MONOTONIC) - _prof_timed) \
+        - (t_num_prof.rd_ns - _prof_timed_rd);
+
+#define PROF_IO_BEGIN(DIR)                                                  \
+    uint64_t _prof_io = num_prof_clock(CLOCK_MONOTONIC);                    \
+    atomic_fetch_add_explicit(&g_num_prof.in_##DIR, 1, memory_order_relaxed);
+
+#define PROF_IO_END(DIR, BYTES)                                                         \
+    {                                                                                   \
+        uint64_t _prof_dt = num_prof_clock(CLOCK_MONOTONIC) - _prof_io;                 \
+        uint64_t _prof_bytes = (BYTES);                                                 \
+        t_num_prof.DIR##_ns += _prof_dt;                                                \
+        t_num_prof.DIR##_bytes += _prof_bytes;                                          \
+        atomic_fetch_sub_explicit(&g_num_prof.in_##DIR, 1, memory_order_relaxed);       \
+        atomic_fetch_add_explicit(&g_num_prof.DIR##_ns, _prof_dt, memory_order_relaxed);\
+        atomic_fetch_add_explicit(&g_num_prof.DIR##_bytes, _prof_bytes, memory_order_relaxed); \
+        atomic_fetch_add_explicit(&g_num_prof.DIR##_calls, 1, memory_order_relaxed);    \
+    }
+
+#else
+
+#define PROF_DEFINE
+#define PROF_VERIFY_BEGIN(KEY, COUNT)
+#define PROF_VERIFY_END(KEY)
+#define PROF_VERIFY_WROTE(KEY, ELEM, LIMBS, N, WIDTH)
+#define PROF_VERIFY_READ(KEY, ELEM, LIMBS, N, WIDTH)
+#define PROF_COUNTER(NAME)
+#define PROF_COUNT(NAME)
+#define PROF_PASS_NAME(DIR, IDX)
+#define PROF_STAGE(NAME)
+#define PROF_DYNAMIC(COND) (COND)
+#define PROF_SLOW_ENTER
+#define PROF_SLOW_BLOCK
+#define PROF_PHASE(NAME)
+#define PROF_MARK(LABEL)
+#define PROF_UNITS(ON, COUNT)
+#define PROF_WORKER_ENTER(ON)
+#define PROF_WORKER_LEAVE(ON)
+#define PROF_ROUND_BEGIN(ON)
+#define PROF_ROUND_END(KIND, WORKER, ROUND, R, GL)
+#define PROF_TIMED_BEGIN
+#define PROF_TIMED_END(FIELD)
+#define PROF_IO_BEGIN(DIR)
+#define PROF_IO_END(DIR, BYTES)
+
+#endif
+
+#endif
