+static uint64_t probe_t0;
+static _Atomic(const char *) probe_label = "-";
+
+static double probe_mb(uint64_t bytes)
+{
+    return (double)bytes / (1024.0 * 1024.0);
+}
+
+static double probe_gb(uint64_t bytes)
+{
+    return (double)bytes / (1024.0 * 1024.0 * 1024.0);
+}
+
+// busiest whole disk, as the fraction of the interval it had I/O in flight
+static double probe_dev_util(const probe_sys_t * sys, const probe_sys_t * prev, double dt)
+{
+    double util = 0.0;
+    for(uint64_t i=0; i<sys->devs && i<prev->devs; i++)
+    {
+        double busy = (double)(sys->dev_busy_ms[i] - prev->dev_busy_ms[i]) / (1e3 * dt);
+        if(busy > util)
+        {
+            util = busy;
+        }
+    }
+    return util;
+}
+
+typedef struct
+{
+    FILE * fp;
+    uint64_t period_ns;
+    atomic_bool stop;
+} probe_sampler_t;
+
+constexpr uint64_t probe_sub_samples = 20;
+
+static void probe_sleep(uint64_t ns)
+{
+    struct timespec ts =
+    {
+        .tv_sec = (time_t)(ns / nanosecs_in_sec),
+        .tv_nsec = (long)(ns % nanosecs_in_sec),
+    };
+    nanosleep(&ts, nullptr);
+}
+
+static void * probe_sampler(void * arg)
+{
+    probe_sampler_t * s = arg;
+
+    fprintf(
+        s->fp,
+        "t\tepoch\tlabel\tstage\tphase\tunits_s\tact\tin_rd\tin_wr\tcpu\tcpu_sys"
+        "\tapp_rd_mb\tapp_wr_mb\tdsk_rd_mb\tdsk_wr_mb\tpgin_s\tmajflt_s"
+        "\tsys_busy\tsys_kern\tfree_mb\tfile_mb\tanon_mb\tcomp_mb\tswap_mb"
+        "\tvm_in_mb\tvm_out_mb\tcomp_s\tdecomp_s\tswapin_s\tswapout_s"
+        "\tmemlvl\ttherm\tlpm\tfootprint_mb"
+        "\tiowait\tdirty_mb\twback_mb\tpsi_io_some\tpsi_io_full\tpsi_mem_some\tpsi_mem_full"
+        "\tscan_direct_s\tallocstall_s\tdev_rd_mb\tdev_wr_mb\tdev_util\tdev_queue\tcores\n"
+    );
+
+    probe_proc_t proc_0 = probe_proc_read();
+    probe_sys_t sys_0 = probe_sys_read();
+    probe_prof_t prof_0 = probe_prof_read();
+    uint64_t t_prev = get_time();
+
+    while(!atomic_load(&s->stop))
+    {
+        uint64_t acc_active = 0;
+        uint64_t acc_rd = 0;
+        uint64_t acc_wr = 0;
+        uint64_t taken = 0;
+        for(uint64_t i=0; i<probe_sub_samples && !atomic_load(&s->stop); i++)
+        {
+            probe_sleep(s->period_ns / probe_sub_samples);
+            probe_prof_t sub = probe_prof_read();
+            acc_active += sub.active;
+            acc_rd += sub.in_rd;
+            acc_wr += sub.in_wr;
+            taken++;
+        }
+
+        uint64_t t_now = get_time();
+        double dt = dtime(t_now - t_prev);
+        probe_proc_t proc = probe_proc_read();
+        probe_sys_t sys = probe_sys_read();
+        probe_prof_t prof = probe_prof_read();
+
+        fprintf(
+            s->fp,
+            "%.2f\t%.2f\t%s\t%s\t%s\t%.0f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f"
+            "\t%.1f\t%.1f\t%.1f\t%.1f\t%.0f\t%.0f"
+            "\t%.2f\t%.2f\t%.0f\t%.0f\t%.0f\t%.0f\t%.0f"
+            "\t%.1f\t%.1f\t%.0f\t%.0f\t%.0f\t%.0f"
+            "\t" U64P() "\t" U64P() "\t" U64P() "\t%.0f"
+            "\t%.2f\t%.0f\t%.0f\t%.3f\t%.3f\t%.3f\t%.3f"
+            "\t%.0f\t%.0f\t%.1f\t%.1f\t%.2f\t%.2f\t",
+            dtime(t_now - probe_t0),
+            get_wall_time(),
+            atomic_load(&probe_label),
+            prof.stage,
+            prof.phase,
+            (double)(prof.units - prof_0.units) / dt,
+            (double)acc_active / (double)taken,
+            (double)acc_rd / (double)taken,
+            (double)acc_wr / (double)taken,
+            dtime((proc.user_ns - proc_0.user_ns) + (proc.sys_ns - proc_0.sys_ns)) / dt,
+            dtime(proc.sys_ns - proc_0.sys_ns) / dt,
+            probe_mb(prof.rd_bytes - prof_0.rd_bytes) / dt,
+            probe_mb(prof.wr_bytes - prof_0.wr_bytes) / dt,
+            probe_mb(proc.disk_rd - proc_0.disk_rd) / dt,
+            probe_mb(proc.disk_wr - proc_0.disk_wr) / dt,
+            (double)(proc.pageins - proc_0.pageins) / dt,
+            (double)(proc.majflt - proc_0.majflt) / dt,
+            (double)(sys.busy_ticks - sys_0.busy_ticks) / (100.0 * dt),
+            (double)(sys.kern_ticks - sys_0.kern_ticks) / (100.0 * dt),
+            probe_mb(sys.free_bytes),
+            probe_mb(sys.file_bytes),
+            probe_mb(sys.anon_bytes),
+            probe_mb(sys.comp_bytes),
+            probe_mb(sys.swap_used),
+            probe_mb(sys.pagein_bytes - sys_0.pagein_bytes) / dt,
+            probe_mb(sys.pageout_bytes - sys_0.pageout_bytes) / dt,
+            (double)(sys.compressions - sys_0.compressions) / dt,
+            (double)(sys.decompressions - sys_0.decompressions) / dt,
+            (double)(sys.swapins - sys_0.swapins) / dt,
+            (double)(sys.swapouts - sys_0.swapouts) / dt,
+            sys.mem_level,
+            sys.thermal,
+            sys.lpm,
+            probe_mb(proc.footprint),
+            (double)(sys.iowait_ticks - sys_0.iowait_ticks) / (100.0 * dt),
+            probe_mb(sys.dirty_bytes),
+            probe_mb(sys.writeback_bytes),
+            (double)(sys.psi_io_some - sys_0.psi_io_some) / (1e6 * dt),
+            (double)(sys.psi_io_full - sys_0.psi_io_full) / (1e6 * dt),
+            (double)(sys.psi_mem_some - sys_0.psi_mem_some) / (1e6 * dt),
+            (double)(sys.psi_mem_full - sys_0.psi_mem_full) / (1e6 * dt),
+            (double)(sys.scan_direct - sys_0.scan_direct) / dt,
+            (double)(sys.allocstall - sys_0.allocstall) / dt,
+            probe_mb(sys.dev_rd_bytes - sys_0.dev_rd_bytes) / dt,
+            probe_mb(sys.dev_wr_bytes - sys_0.dev_wr_bytes) / dt,
+            probe_dev_util(&sys, &sys_0, dt),
+            (double)(sys.dev_queue_ms - sys_0.dev_queue_ms) / (1e3 * dt)
+        );
+        for(uint64_t i=0; i<sys.cpus; i++)
+        {
+            double busy = (double)(sys.busy[i] - sys_0.busy[i]) / dt;
+            fprintf(s->fp, "%s%.0f", i ? "," : "", busy);
+        }
+        fprintf(s->fp, "\n");
+
+        if(sys.lpm == 1)
+        {
+            fprintf(s->fp, "ABORT low power mode enabled\n");
+            fflush(s->fp);
+            printf("\n\n*** LOW POWER MODE ENABLED at t=%.1f s -- run aborted ***\n\n", dtime(t_now - probe_t0));
+            _exit(77);
+        }
+
+        proc_0 = proc;
+        sys_0 = sys;
+        prof_0 = prof;
+        t_prev = t_now;
+    }
+
+    return nullptr;
+}
+
+
+
+#ifdef ARAUCARIA_PROF
+
+static FILE * probe_rounds_fp;
+static FILE * probe_marks_fp;
+
+typedef struct
+{
+    uint64_t t;
+    probe_proc_t proc;
+    probe_prof_t prof;
+} probe_mark_t;
+
+static probe_mark_t probe_mark_prev;
+
+static probe_mark_t probe_mark_now()
+{
+    return (probe_mark_t)
+    {
+        .t = get_time(),
+        .proc = probe_proc_read(),
+        .prof = probe_prof_read(),
+    };
+}
+
+static void probe_on_mark(const char * label)
+{
+    probe_mark_t now = probe_mark_now();
+    probe_mark_t * prev = &probe_mark_prev;
+
+    double wall = dtime(now.t - prev->t);
+    double user = dtime(now.proc.user_ns - prev->proc.user_ns);
+    double sys = dtime(now.proc.sys_ns - prev->proc.sys_ns);
+    double rd_gb = probe_gb(now.prof.rd_bytes - prev->prof.rd_bytes);
+    double wr_gb = probe_gb(now.prof.wr_bytes - prev->prof.wr_bytes);
+    double rd_s = dtime(now.prof.rd_ns - prev->prof.rd_ns);
+    double wr_s = dtime(now.prof.wr_ns - prev->prof.wr_ns);
+    double dsk_rd = probe_gb(now.proc.disk_rd - prev->proc.disk_rd);
+    double dsk_wr = probe_gb(now.proc.disk_wr - prev->proc.disk_wr);
+    uint64_t pageins = now.proc.pageins - prev->proc.pageins;
+    uint64_t majflt = now.proc.majflt - prev->proc.majflt;
+
+    printf(
+        "\n[%9.2f] %-5s %-13s wall %8.2f  cpu %8.2f (u %8.2f s %7.2f)  "
+        "rd %7.2f GB %7.1f s  wr %7.2f GB %7.1f s  dsk %6.2f/%6.2f GB  pgin " U64P(8),
+        dtime(now.t - probe_t0), now.prof.stage, label, wall, user + sys, user, sys,
+        rd_gb, rd_s, wr_gb, wr_s, dsk_rd, dsk_wr, pageins
+    );
+    fprintf(
+        probe_marks_fp,
+        "%.3f\t%s\t%s\t%.3f\t%.3f\t%.3f\t%.3f\t%.1f\t%.3f\t%.1f\t%.3f\t%.3f\t" U64P() "\t" U64P() "\n",
+        dtime(now.t - probe_t0), now.prof.stage, label, wall, user, sys,
+        rd_gb, rd_s, wr_gb, wr_s, dsk_rd, dsk_wr, pageins, majflt
+    );
+
+    probe_mark_prev = now;
+}
+
+static void probe_on_round(
+    const char * kind,
+    uint64_t worker,
+    uint64_t round,
+    uint64_t r,
+    uint64_t gl,
+    const num_prof_round_t * stat
+)
+{
+    const char * stage = atomic_load(&g_num_prof.stage);
+    fprintf(
+        probe_rounds_fp,
+        "%.3f\t%s\t%s\t" U64P() "\t" U64P() "\t" U64P() "\t" U64P()
+        "\t%.3f\t%.3f\t%.3f\t%.3f\t%.3f\t%.3f\t%.3f\t%.3f\n",
+        dtime(get_time() - probe_t0), stage ? stage : "-", kind, worker, round, r, gl,
+        dtime(stat->wall_ns), dtime(stat->cpu_ns), dtime(stat->rd_ns), dtime(stat->wr_ns),
+        dtime(stat->pad_ns), dtime(stat->pw_ns),
+        probe_gb(stat->rd_bytes), probe_gb(stat->wr_bytes)
+    );
+}
+
+#endif
+
+
+
+static FILE * probe_open(const char * prefix, const char * suffix)
+{
+    constexpr uint64_t path_max = 1024;
+    char path[path_max];
+    snprintf(path, sizeof(path), "%s.%s", prefix, suffix);
+    FILE * fp = fopen(path, "w");
+    assert(fp);
+    setvbuf(fp, nullptr, _IOLBF, 0);
+    return fp;
+}
+
+static uint64_t probe_arg(const char * str)
+{
+    char * end = nullptr;
+    errno = 0;
+    uint64_t value = strtoull(str, &end, 10);
+    assert(errno == 0 && end != str && *end == '\0');
+    return value;
+}
+
+// probe <log prefix> <limbs per operand> <threads> <threshold MB> <budget MB> [seed] [mul|sqr]
+// a threshold of 0 keeps everything in RAM
+static int probe_main(int argc, char ** argv)
+{
+    constexpr uint64_t mb = U64(1) * 1024 * 1024;
+
+    if(argc < 7)
+    {
+        printf("usage: %s probe <log prefix> <limbs> <threads> <threshold MB> <budget MB> [seed] [mul|sqr]\n", argv[0]);
+        return 2;
+    }
+
+    const char * prefix = argv[2];
+    uint64_t count = probe_arg(argv[3]);
+    uint64_t threads = probe_arg(argv[4]);
+    uint64_t threshold_mb = probe_arg(argv[5]);
+    uint64_t budget_mb = probe_arg(argv[6]);
+    uint64_t seed = argc > 7 ? probe_arg(argv[7]) : 1;
+    bool sqr = (bool)(argc > 8 && strcmp(argv[8], "sqr") == 0);
+
+    const char * disk_path = getenv("PROBE_DISK_PATH");
+    const char * period_ms = getenv("PROBE_PERIOD_MS");
+
+    araucaria_disk_config_t config =
+    {
+        .disk_path = disk_path ? disk_path : "./cache",
+        .disk_threshold_bytes = threshold_mb ? threshold_mb * mb : UINT64_MAX,
+        .ram_budget_bytes = budget_mb * mb,
+    };
+#ifdef PROBE_HAS_DIRECT_IO
+    config.direct_io = (bool)(getenv("PROBE_DIRECT") != nullptr);
+#endif
+    araucaria_disk_config_set(&config);
+
+    probe_t0 = get_time();
+    probe_page_bytes = (uint64_t)sysconf(_SC_PAGESIZE);
+
+    printf(
+        "probe: %s  limbs " U64P() " (%.2f GB/operand)  threads " U64P()
+        "  threshold " U64P() " MB  budget " U64P() " MB  seed " U64P() "  disk %s\n",
+        sqr ? "sqr" : "mul", count, probe_gb(count * sizeof(uint64_t)), threads, threshold_mb,
+        budget_mb, seed, config.disk_path
+    );
+
+    probe_sampler_t sampler =
+    {
+        .fp = probe_open(prefix, "samples.tsv"),
+        .period_ns = (period_ms ? probe_arg(period_ms) : 1000) * 1'000'000,
+    };
+    pthread_t sampler_id;
+    TREAT(pthread_create(&sampler_id, nullptr, probe_sampler, &sampler))
+
+#ifdef ARAUCARIA_PROF
+    probe_rounds_fp = probe_open(prefix, "rounds.tsv");
+    probe_marks_fp = probe_open(prefix, "marks.tsv");
+    fprintf(
+        probe_rounds_fp,
+        "t\tstage\tkind\tworker\tround\tr\tgl\twall\tcpu\trd_s\twr_s\tpad_s\tpw_s\trd_gb\twr_gb\n"
+    );
+    fprintf(
+        probe_marks_fp,
+        "t\tstage\tlabel\twall\tuser\tsys\trd_gb\trd_s\twr_gb\twr_s\tdsk_rd_gb\tdsk_wr_gb\tpageins\tmajflt\n"
+    );
+#endif
+
+    atomic_store(&probe_label, "generate");
+    uint64_t t_gen = get_time();
+    uint64_t res_1;
+    num_p num_1 = probe_generate(count, seed, &res_1);
+    uint64_t res_2 = res_1;
+    num_p num_2 = nullptr;
+    if(!sqr)
+    {
+        num_2 = probe_generate(count, seed ^ 0x5851f42d4c957f2d, &res_2);
+    }
+    uint64_t expected = probe_mul_mod(res_1, res_2);
+    printf("generate: %.2f s\n", dtime(get_time() - t_gen));
+
+#ifdef ARAUCARIA_PROF
+    probe_mark_prev = probe_mark_now();
+    g_num_prof.on_mark = probe_on_mark;
+    g_num_prof.on_round = probe_on_round;
+    atomic_store(&g_num_prof_verify_on, getenv("PROBE_IOVERIFY") != nullptr);
+    atomic_store(&g_num_prof.static_ranges, getenv("PROBE_STATIC") != nullptr);
+    const char * slow_ms = getenv("PROBE_SLOW_MS");
+    atomic_store(&g_num_prof.slow_ns, slow_ms ? probe_arg(slow_ms) * 1'000'000 : 0);
+#endif
+
+    atomic_store(&probe_label, "multiply");
+    probe_proc_t proc_0 = probe_proc_read();
+    uint64_t t_mul = get_time();
+    num_p num_res = sqr ? num_sqr_threads(num_1, threads) : num_mul_threads(num_1, num_2, threads);
+    uint64_t mul_ns = get_time() - t_mul;
+    probe_proc_t proc_1 = probe_proc_read();
+
+#ifdef ARAUCARIA_PROF
+    g_num_prof.on_mark = nullptr;
+    g_num_prof.on_round = nullptr;
+    if(atomic_load(&g_num_prof_verify_on))
+    {
+        printf(
+            "\nIOVERIFY ok: " U64P() " staged element reads matched what was written",
+            atomic_load(&g_num_prof_verify_checked)
+        );
+    }
+#endif
+
+    double cpu = dtime((proc_1.user_ns - proc_0.user_ns) + (proc_1.sys_ns - proc_0.sys_ns));
+    printf(
+        "\n\nRESULT multiply %.3f s  cpu %.1f s (sys %.1f)  avg cores %.2f  "
+        "disk rd %.1f GB wr %.1f GB  pageins " U64P() "  product limbs " U64P() "\n",
+        dtime(mul_ns), cpu, dtime(proc_1.sys_ns - proc_0.sys_ns), cpu / dtime(mul_ns),
+        probe_gb(proc_1.disk_rd - proc_0.disk_rd), probe_gb(proc_1.disk_wr - proc_0.disk_wr),
+        proc_1.pageins - proc_0.pageins, num_res->count
+    );
+
+    atomic_store(&probe_label, "verify");
+    uint64_t t_ver = get_time();
+    uint64_t got = probe_residue(num_res);
+    bool ok = got == expected;
+    printf(
+        "VERIFY %s  residue " U64PX " expected " U64PX "  (%.2f s)\n",
+        ok ? "ok" : "FAIL", got, expected, dtime(get_time() - t_ver)
+    );
+
+    num_free(num_res);
+
+    atomic_store(&sampler.stop, true);
+    TREAT(pthread_join(sampler_id, nullptr))
+    fclose(sampler.fp);
+
+    return ok ? 0 : 1;
+}
