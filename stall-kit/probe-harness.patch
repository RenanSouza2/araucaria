+// Out-of-core multiply probe: one num_mul_threads under a sampler that logs where
+// the wall time goes. Included by main.c.
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <unistd.h>
+
+#ifdef __APPLE__
+#include <libproc.h>
+#include <mach/mach.h>
+#include <notify.h>
+#include <sys/sysctl.h>
+#endif
+
+#include "../mods/macros/assert.h"
+#include "../mods/macros/threads.h"
+#include "../mods/macros/time.h"
+#include "../mods/macros/uint.h"
+
+#include "../lib/num/internal.h"
+#include "../lib/num/struct.h"
+
+#ifdef ARAUCARIA_PROF
+#include "../lib/num/prof.h"
+#endif
+
+
+
+// 2^64 - 59, the largest prime below 2^64
+constexpr uint64_t probe_prime = 0xffffffffffffffc5;
+constexpr uint64_t probe_prime_gap = 59;
+
+// (res * 2^64 + value) mod probe_prime, not canonical
+static uint64_t probe_fold(uint64_t res, uint64_t value)
+{
+    uint128_t t = (U128(res) * probe_prime_gap) + value;
+    uint64_t lo = LOW(t);
+    uint64_t sum = lo + (HIGH(t) * probe_prime_gap);
+    return sum < lo ? sum + probe_prime_gap : sum;
+}
+
+static uint64_t probe_canon(uint64_t res)
+{
+    return res >= probe_prime ? res - probe_prime : res;
+}
+
+static uint64_t probe_mul_mod(uint64_t a, uint64_t b)
+{
+    uint128_t t = U128(a) * b;
+    return probe_canon(probe_fold(probe_fold(0, HIGH(t)), LOW(t)));
+}
+
+static uint64_t probe_splitmix(uint64_t * state)
+{
+    uint64_t z = (*state += 0x9e3779b97f4a7c15);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111eb;
+    return z ^ (z >> 31);
+}
+
+// limbs moved per transfer when a number is on disk
+constexpr uint64_t probe_chunk_limbs = U64(8) * 1024 * 1024;
+
+static void probe_pwrite(int fd, const uint64_t * src, uint64_t limbs, uint64_t pos)
+{
+    const char * s = (const char *)src;
+    uint64_t left = limbs * sizeof(uint64_t);
+    off_t off = (off_t)(sizeof(num_t) + (pos * sizeof(uint64_t)));
+    while(left)
+    {
+        ssize_t put = pwrite(fd, s, left, off);
+        assert(put > 0);
+        left -= (uint64_t)put;
+        s += put;
+        off += put;
+    }
+}
+
+static void probe_pread(int fd, uint64_t * dest, uint64_t limbs, uint64_t pos)
+{
+    char * d = (char *)dest;
+    uint64_t left = limbs * sizeof(uint64_t);
+    off_t off = (off_t)(sizeof(num_t) + (pos * sizeof(uint64_t)));
+    while(left)
+    {
+        ssize_t got = pread(fd, d, left, off);
+        assert(got > 0);
+        left -= (uint64_t)got;
+        d += got;
+        off += got;
+    }
+}
+
+// COUNT random limbs with the top one nonzero, filled from the top down.
+// out_residue receives the value mod probe_prime
+static num_p probe_generate(uint64_t count, uint64_t seed, uint64_t * out_residue)
+{
+    num_p num = num_create_dirty(CLU_ARGS(count, count));
+    uint64_t * buf = nullptr;
+    if(num->is_mmap)
+    {
+        buf = malloc(probe_chunk_limbs * sizeof(uint64_t));
+        assert(buf);
+    }
+
+    uint64_t state = seed;
+    uint64_t res = 0;
+    for(uint64_t end = count; end > 0;)
+    {
+        uint64_t len = end < probe_chunk_limbs ? end : probe_chunk_limbs;
+        uint64_t start = end - len;
+        uint64_t * dst = buf ? buf : &num->chunk[start];
+
+        for(uint64_t i = len; i-- > 0;)
+        {
+            uint64_t value = probe_splitmix(&state);
+            if(start + i == count - 1)
+            {
+                value |= B(63);
+            }
+            dst[i] = value;
+            res = probe_fold(res, value);
+        }
+
+        if(buf)
+        {
+            probe_pwrite(num->fd, buf, len, start);
+        }
+        end = start;
+    }
+
+    free(buf);
+    *out_residue = probe_canon(res);
+    return num;
+}
+
+static uint64_t probe_residue(num_p num)
+{
+    uint64_t * buf = nullptr;
+    if(num->is_mmap)
+    {
+        buf = malloc(probe_chunk_limbs * sizeof(uint64_t));
+        assert(buf);
+    }
+
+    uint64_t res = 0;
+    for(uint64_t end = num->count; end > 0;)
+    {
+        uint64_t len = end < probe_chunk_limbs ? end : probe_chunk_limbs;
+        uint64_t start = end - len;
+        const uint64_t * src = &num->chunk[start];
+        if(buf)
+        {
+            probe_pread(num->fd, buf, len, start);
+            src = buf;
+        }
+
+        for(uint64_t i = len; i-- > 0;)
+        {
+            res = probe_fold(res, src[i]);
+        }
+        end = start;
+    }
+
+    free(buf);
+    return probe_canon(res);
+}
+
