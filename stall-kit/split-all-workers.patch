+// Classes the split phase of a transform in RAM is cut into, taken by the workers
+// one at a time: one each when the workers are a power of two, eight times the next
+// power of two otherwise, and never past K / 2
+static uint64_t ssm_split_classes(uint64_t workers, uint64_t K)
+{
+    uint64_t classes = stdc_bit_ceil(workers);
+    if(classes == workers)
+    {
+        return classes;
+    }
+
+    classes *= 8;
+    return classes < K / 2 ? classes : K / 2;
+}
