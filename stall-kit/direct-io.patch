+// Whether a multiply's transform arrays take the direct layout: only when they
+// land on disk, every pass of theirs is staged, and the pointwise multiply is the
+// recursive one, which runs staged too
+static bool ssm_array_is_direct(ssm_params_p p, uint64_t threads)
+{
+    araucaria_disk_config_p config = &s_araucaria_disk_config;
+    uint64_t bytes = sizeof(num_t) + (p->n * p->K * sizeof(uint64_t));
+    if(!config->direct_io || (bytes <= config->disk_threshold_bytes) || !ssm_is_recursive(p->n))
+    {
+        return false;
+    }
+
+    uint64_t workers = ssm_worker_count(threads, p->K / 2);
+    return (bool)((config->ram_budget_bytes / workers) > ssm_fft_block_bytes);
